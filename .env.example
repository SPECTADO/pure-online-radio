# Copy to .env and fill in real values. Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=radio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=radio
DATABASE_URL=postgresql://radio:change-me@postgres:5432/radio?schema=public

# --- Redis ---
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379

# --- MinIO / S3 ---
MINIO_ROOT_USER=radio-admin
MINIO_ROOT_PASSWORD=change-me-min-8-chars
S3_BUCKET=spectado-media
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true

# --- External metadata lookup (song library "search metadata online") ---
# MusicBrainz asks every API consumer for a descriptive User-Agent, ideally
# with a contact URL -- see apps/api/src/modules/library/metadataProviders/musicBrainzProvider.ts
MUSICBRAINZ_USER_AGENT=SpectadoRadio/0.1 ( https://example.com/contact )

# --- NATS ---
API_NATS_PASSWORD=change-me
ENCODER_NATS_PASSWORD=change-me
CONTROL_PANEL_NATS_PASSWORD=change-me

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Internal service-to-service auth (API <-> encoder) ---
ENCODER_CALLBACK_TOKEN=change-me

# --- Seed admin user (packages/database seed script) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me

# --- Misc ---
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost
# Host port Caddy binds to for HTTP. Change if :80 is already taken on your
# machine (e.g. by a local Apache/another dev server) — keep PUBLIC_BASE_URL
# in sync with whatever you set here.
WEBSERVER_HOST_PORT=80
# Host port Caddy binds to for HTTPS. Only matters if SITE_ADDRESS below is
# set to a real domain.
WEBSERVER_HTTPS_PORT=443
# Leave unset for local/LAN use (plain HTTP only). Set to a real public
# domain name (with DNS + ports 80/443 reachable from the internet) to get
# an automatic, auto-renewing Let's Encrypt HTTPS certificate with no other
# config change — see apps/webserver/Caddyfile.
SITE_ADDRESS=
# Optional contact email for Let's Encrypt expiry/renewal-problem notices.
# Only relevant when SITE_ADDRESS is set to a real domain.
ACME_EMAIL=
