generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────

enum Role {
  MANAGER
  ADMIN
}

enum MediaKind {
  SONG
  JINGLE
  AD
}

enum SelectionStrategy {
  RANDOM
  LEAST_RECENTLY_PLAYED
  WEIGHTED_RECENCY // weighted-random toward stale tracks; more strategies may be added later
}

enum JingleType {
  STATION_ID
  SWEEPER
  SFX
  PROMO
  ADVERT
  OTHER
}

enum ScheduledItemStatus {
  PENDING
  PLAYED
  SKIPPED
  CANCELLED
}

enum ExternalStreamStatus {
  SCHEDULED
  PLAYING
  STOPPED
  FAILED
  CANCELLED
}

enum SeparationRuleScope {
  GLOBAL
  CLOCK_WHEEL // future: scoped to a specific ClockWheel
}

enum ScheduleTriggerType {
  ONE_TIME // runAt
  WEEKLY // weekdays + timeOfDay
  INTERVAL // weekdays + intervalMinutes [+ windowStart/windowEnd]
  PLAY_COUNT // everyNPlays (songs played)
}

enum ScheduleInsertionMode {
  ASAP // let the current item finish, then insert
  AT_TIME // interrupt the current item immediately
}

enum ExternalStreamEndBehavior {
  NATURAL // stop when the source itself stops (on-demand EOF / live disconnect)
  AT_TIME // force-stop at an absolute datetime (endAt)
  AFTER_DURATION // force-stop durationMs after the relay actually started
}

enum PlaybackSource {
  CLOCK_WHEEL
  SCHEDULED_ITEM
  MANUAL
  EXTERNAL_STREAM
  LIVE_MIC
}

enum PlaybackMediaKind {
  SONG
  JINGLE
  AD
  EXTERNAL_STREAM
  LIVE_MIC
}

enum StreamCodec {
  AAC
  MP3
}

// ── Users / auth ─────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         Role      @default(MANAGER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdSongs           Song[]                @relation("SongCreatedBy")
  createdJingles         Jingle[]               @relation("JingleCreatedBy")
  createdAds             Ad[]                  @relation("AdCreatedBy")
  createdScheduledItems   ScheduledItem[]
  createdScheduleRules    ScheduleRule[]
  createdExternalStreams  ExternalStream[]
  updatedSeparationRules  SeparationRule[]
  updatedStationSettings  StationSettings[]
  updatedScratchPads      ScratchPad[]
  updatedStreamSettings   StreamSettings[]
  commandAuditLogs        CommandAuditLog[]
}

// ── Library: songs & jingles ─────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String   @unique // "ALL", "TOP", "HITS", ...
  createdAt DateTime @default(now())

  songs           Song[]
  jingles         Jingle[]
  ads             Ad[]
  clockWheelSteps ClockWheelStep[]
}

model Song {
  id            String    @id @default(cuid())
  title         String
  artist        String
  album         String?
  durationMs    Int
  fileKey       String    @unique // MinIO object key, e.g. songs/{id}/original.mp3
  fileMimeType  String
  fileSizeBytes Int
  coverArtKey   String? // MinIO object key for extracted/uploaded cover art
  categories    Category[] // user-defined; every song is also always attached to "ALL"
  tags          String[]  @default([])
  isActive      Boolean   @default(true) // soft-disable, keeps history FKs intact
  stationId     String? // multi-station scaffold, unused in v1
  createdById   String?
  createdBy     User?     @relation("SongCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  scheduledItems   ScheduledItem[]
  scheduleRuleItems ScheduleRuleItem[]
  playbackHistory  PlaybackHistoryEntry[]

  @@index([artist])
}

model Jingle {
  id            String     @id @default(cuid())
  title         String
  type          JingleType @default(OTHER)
  tags          String[]   @default([])
  durationMs    Int
  fileKey       String     @unique
  fileMimeType  String
  fileSizeBytes Int
  categories    Category[] // user-defined; every jingle is also always attached to "ALL"
  isActive      Boolean    @default(true)
  stationId     String?
  createdById   String?
  createdBy     User?      @relation("JingleCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  scheduledItems   ScheduledItem[]
  scheduleRuleItems ScheduleRuleItem[]
  playbackHistory  PlaybackHistoryEntry[]

  @@index([type])
}

// ── Ads ───────────────────────────────────────────────────────────────────
// A third media kind alongside songs/jingles: no user-facing categories (the
// app layer only ever attaches the single "ALL" category, so ad selection can
// reuse the same category-scoped queries as songs/jingles later without a
// special case) but a mandatory datetime active window -- queue resolution
// (still a TODO stub elsewhere in this codebase) must exclude any Ad outside
// [activeFrom, activeUntil] rather than ever falling back to "always eligible".

model Ad {
  id            String     @id @default(cuid())
  title         String
  durationMs    Int
  fileKey       String     @unique
  fileMimeType  String
  fileSizeBytes Int
  activeFrom    DateTime
  activeUntil   DateTime
  categories    Category[] // app layer restricts this to "ALL" only -- see ads.routes.ts
  isActive      Boolean    @default(true)
  stationId     String?
  createdById   String?
  createdBy     User?      @relation("AdCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  scheduledItems    ScheduledItem[]
  scheduleRuleItems ScheduleRuleItem[]
  playbackHistory   PlaybackHistoryEntry[]

  @@index([activeFrom, activeUntil])
}

// ── One-off scheduled items ──────────────────────────────────────────────

model ScheduledItem {
  id           String              @id @default(cuid())
  // null = a manually-queued item ("play as soon as due" -- the FIFO manual
  // queue orders these by `position`); non-null = a time-scheduled one-off
  // item (the not-yet-built Schedule feature).
  scheduledFor DateTime?
  position     Int                 @default(0) // ordering when several items share a timestamp (or are all unscheduled)
  mediaKind    MediaKind
  songId       String?
  song         Song?               @relation(fields: [songId], references: [id])
  jingleId     String?
  jingle       Jingle?             @relation(fields: [jingleId], references: [id])
  adId         String?
  ad           Ad?                 @relation(fields: [adId], references: [id])
  status       ScheduledItemStatus @default(PENDING)
  // Non-null when this row was materialized by a ScheduleRule firing (as opposed to a
  // manager manually queuing/one-off-scheduling an item) -- traceability only, doesn't
  // change how the row is claimed/played. SetNull (not Cascade) so deleting the rule
  // doesn't erase already-played history.
  scheduleRuleId String?
  scheduleRule   ScheduleRule?       @relation(fields: [scheduleRuleId], references: [id], onDelete: SetNull)
  // Non-null when this row was materialized by the clock-wheel fill engine (see
  // apps/api/src/scheduler/clockWheelEngine.ts) -- same traceability-only convention as
  // scheduleRuleId above. `scheduledFor` on a clock-wheel row is an *estimate* used for
  // wheel-matching/horizon accounting only, not a claim-time gate -- see claimNextQueueItem.
  clockWheelStepId String?
  clockWheelStep   ClockWheelStep?   @relation(fields: [clockWheelStepId], references: [id], onDelete: SetNull)
  stationId    String?
  // Null for system-generated rows (clock-wheel fills have no acting user) -- same nullable
  // pattern as Song/Jingle/Ad.createdById.
  createdById  String?
  createdBy    User?               @relation(fields: [createdById], references: [id])
  createdAt    DateTime            @default(now())
  playedAt     DateTime?

  playbackHistory PlaybackHistoryEntry[]

  @@index([scheduledFor, status])
  // NOTE: Prisma cannot express "exactly one of songId/jingleId/adId set, matching mediaKind"
  // as a schema-level constraint. Enforce in the application layer (zod) and optionally
  // add a hand-written CHECK constraint via a raw-SQL migration.
}

// ── Clock wheels ─────────────────────────────────────────────────────────

model ClockWheel {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  // Exactly one row has isDefault = true (app-enforced singleton, same pattern as the
  // GLOBAL SeparationRule) -- fills any time no other active wheel's slot matches. Its
  // own `slots` are always empty/ignored; it can be edited (steps only) but never deleted.
  isDefault Boolean  @default(false)
  // Persisted round-robin pointer into `steps` (index = rotationCursor % steps.length) --
  // survives across scheduler ticks/restarts and a wheel's non-contiguous active windows.
  rotationCursor Int @default(0)
  stationId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots           ClockWheelSlot[]
  steps           ClockWheelStep[]
  separationRules SeparationRule[] // future per-wheel scoping
}

model ClockWheelSlot {
  id           String     @id @default(cuid())
  clockWheelId String
  clockWheel   ClockWheel @relation(fields: [clockWheelId], references: [id], onDelete: Cascade)
  weekdays     Int[] // 0=Sun..6=Sat; e.g. Mon-Fri => [1,2,3,4,5]
  startTime    DateTime   @db.Time()
  endTime      DateTime   @db.Time()

  @@index([clockWheelId])
}

model ClockWheelStep {
  id                String            @id @default(cuid())
  clockWheelId      String
  clockWheel        ClockWheel        @relation(fields: [clockWheelId], references: [id], onDelete: Cascade)
  order             Int
  mediaKind         MediaKind
  selectionStrategy SelectionStrategy
  categoryId        String? // null = all categories (any mediaKind)
  category          Category?         @relation(fields: [categoryId], references: [id])
  tag               String? // optional filter, e.g. jingle tag
  createdAt         DateTime          @default(now())

  playbackHistory PlaybackHistoryEntry[]
  scheduledItems  ScheduledItem[]

  @@unique([clockWheelId, order])
}

// ── Schedule rules (recurring/one-off song/jingle/ad blocks) ─────────────
// A rule defines *when* to fire (one of the 4 ScheduleTriggerType shapes) and
// *how* to insert (ScheduleInsertionMode); firing materializes one ScheduledItem
// per ScheduleRuleItem (in order) with scheduledFor = the fire time -- see
// apps/api/src/scheduler/. A plain "run once at this date/time" schedule is
// just triggerType = ONE_TIME, which deactivates itself after firing.

model ScheduleRule {
  id            String                @id @default(cuid())
  name          String
  isActive      Boolean               @default(true)
  triggerType   ScheduleTriggerType
  insertionMode ScheduleInsertionMode @default(ASAP)

  // ONE_TIME
  runAt DateTime?

  // WEEKLY: weekdays + timeOfDay. INTERVAL: weekdays + intervalMinutes [+ window].
  weekdays        Int[]     @default([]) // 0=Sun..6=Sat; empty = every day (INTERVAL only)
  timeOfDay       DateTime? @db.Time()
  intervalMinutes Int?
  windowStart     DateTime? @db.Time() // null = from midnight
  windowEnd       DateTime? @db.Time() // null = to end of day

  // PLAY_COUNT
  everyNPlays           Int?
  playsSinceLastTrigger Int @default(0)

  lastTriggeredAt DateTime?
  stationId       String?
  createdById     String
  createdBy       User      @relation(fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items          ScheduleRuleItem[]
  scheduledItems ScheduledItem[] // materialized occurrences, traceability only

  @@index([triggerType, isActive])
}

model ScheduleRuleItem {
  id             String       @id @default(cuid())
  scheduleRuleId String
  scheduleRule   ScheduleRule @relation(fields: [scheduleRuleId], references: [id], onDelete: Cascade)
  order          Int
  mediaKind      MediaKind
  songId         String?
  song           Song?        @relation(fields: [songId], references: [id])
  jingleId       String?
  jingle         Jingle?      @relation(fields: [jingleId], references: [id])
  adId           String?
  ad             Ad?          @relation(fields: [adId], references: [id])
  // NOTE: same "exactly one of songId/jingleId/adId set, matching mediaKind" constraint
  // as ScheduledItem -- enforced in the application layer (zod), not the schema.

  @@unique([scheduleRuleId, order])
}

// ── Separation rules (global today, scopable later) ──────────────────────

model SeparationRule {
  id                      String              @id @default(cuid())
  scope                   SeparationRuleScope @default(GLOBAL)
  clockWheelId            String? // null while scope = GLOBAL
  clockWheel              ClockWheel?         @relation(fields: [clockWheelId], references: [id])
  artistSeparationMinutes Int                 @default(60)
  albumSeparationMinutes  Int                 @default(90)
  songSeparationMinutes   Int                 @default(120)
  updatedAt               DateTime            @updatedAt
  updatedById             String?
  updatedBy               User?               @relation(fields: [updatedById], references: [id])
  // App enforces a single GLOBAL row for v1. Add via raw-SQL migration if DB-level
  // enforcement is wanted:
  //   CREATE UNIQUE INDEX one_global_separation_rule ON "SeparationRule" (scope)
  //   WHERE scope = 'GLOBAL' AND "clockWheelId" IS NULL;
}

// ── Station branding (name/logo/description/links) ───────────────────────
// A single row (app enforces this via findFirst-or-create, same pattern as
// the single GLOBAL SeparationRule above) -- public-readable, manager-editable.

model StationSettings {
  id           String   @id @default(cuid())
  name         String   @default("Spectado Radio")
  description  String?
  logoKey      String? // MinIO object key, square image
  logoMimeType String?
  links        Json     @default("[]") // StationLinkDTO[] -- {platform, url, label?}
  timeFormat   String   @default("12h") // TimeFormat -- "12h" | "24h"
  // How far ahead the clock-wheel fill engine keeps the queue planned -- see
  // apps/api/src/scheduler/clockWheelEngine.ts.
  queuePlanningHorizonMinutes Int @default(240)
  updatedAt    DateTime @updatedAt
  updatedById  String?
  updatedBy    User?    @relation(fields: [updatedById], references: [id])
}

// ── Stream (HLS encode) settings ──────────────────────────────────────────
// A single row (app enforces this via findFirst-or-create, same pattern as
// StationSettings above). Read once by the encoder at boot to build its
// ffmpeg HLS argv (see apps/encoder/src/process/masterEncoder.ts) -- there is
// no live-reload path today, so a change here only takes effect the next
// time the encoder process restarts.
model StreamSettings {
  id             String      @id @default(cuid())
  codec          StreamCodec @default(AAC)
  lowBitrateKbps  Int        @default(64)
  highBitrateKbps Int        @default(256)
  // Ignored in favor of a fixed short duration while lowLatencyEnabled is
  // true -- see masterEncoder.ts. segmentSeconds * segmentCount is the
  // live-edge/time-shift (DVR) window in both modes.
  segmentSeconds    Int     @default(4)
  segmentCount      Int     @default(8)
  lowLatencyEnabled Boolean @default(false)
  updatedAt      DateTime    @updatedAt
  updatedById    String?
  updatedBy      User?       @relation(fields: [updatedById], references: [id])
}

// 2x5 grid of manager-assignable jingle shortcuts on the Dashboard -- singleton
// row, same findFirst-or-create pattern as StationSettings above.
model ScratchPad {
  id          String   @id @default(cuid())
  slots       Json     @default("[]") // ScratchPadSlotDTO[] -- {position, jingleId}[]
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
}

// ── External stream scheduling ────────────────────────────────────────────

model ExternalStream {
  id     String               @id @default(cuid())
  name   String
  url    String
  status ExternalStreamStatus @default(SCHEDULED)

  // Same trigger shape as ScheduleRule -- see apps/api/src/scheduler/.
  triggerType     ScheduleTriggerType
  insertionMode   ScheduleInsertionMode @default(ASAP)
  runAt           DateTime? // ONE_TIME
  weekdays        Int[]     @default([]) // WEEKLY, INTERVAL
  timeOfDay       DateTime? @db.Time() // WEEKLY
  intervalMinutes Int? // INTERVAL
  windowStart     DateTime? @db.Time() // INTERVAL, null = from midnight
  windowEnd       DateTime? @db.Time() // INTERVAL, null = to end of day
  everyNPlays           Int? // PLAY_COUNT
  playsSinceLastTrigger Int @default(0)
  lastTriggeredAt       DateTime?

  // Independent of the trigger: how a PLAYING relay stops.
  endBehavior ExternalStreamEndBehavior @default(NATURAL)
  endAt       DateTime? // required (app layer) when endBehavior = AT_TIME
  durationMs  Int? // required (app layer) when endBehavior = AFTER_DURATION
  startedAt   DateTime? // actual runtime start of the current/most recent PLAYING run

  stationId   String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  playbackHistory PlaybackHistoryEntry[]

  @@index([triggerType, status])
}

// ── Now-playing / history ─────────────────────────────────────────────────
// Live "now playing" state is served from Redis; this table is the durable
// append-only log used for separation-rule lookups + reporting, and can
// reconstruct "now playing" (latest row, endedAt IS NULL) if Redis is cold.

model PlaybackHistoryEntry {
  id               String            @id @default(cuid())
  mediaKind        PlaybackMediaKind
  songId           String?
  song             Song?             @relation(fields: [songId], references: [id])
  jingleId         String?
  jingle           Jingle?           @relation(fields: [jingleId], references: [id])
  adId             String?
  ad               Ad?               @relation(fields: [adId], references: [id])
  externalStreamId String?
  externalStream   ExternalStream?   @relation(fields: [externalStreamId], references: [id])
  source           PlaybackSource
  clockWheelStepId String? // traceability: which rule picked this item
  clockWheelStep   ClockWheelStep?   @relation(fields: [clockWheelStepId], references: [id])
  scheduledItemId  String?
  scheduledItem    ScheduledItem?    @relation(fields: [scheduledItemId], references: [id])
  startedAt        DateTime
  endedAt          DateTime?
  durationMs       Int?
  titleSnapshot    String // denormalized: history stays correct if Song/Jingle later edited/deleted
  artistSnapshot   String?
  stationId        String?
  createdAt        DateTime          @default(now())

  @@index([songId, startedAt])
  @@index([startedAt])
}

// ── Command audit log (API -> NATS command publishing) ───────────────────

model CommandAuditLog {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  commandSubject String // e.g. "radio.encoder.cmd.advance"
  payload        Json
  result         String? // "published" | "rejected" | error detail
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}
