generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────

enum Role {
  MANAGER
  ADMIN
}

enum MediaKind {
  SONG
  JINGLE
  AD
}

enum SelectionStrategy {
  RANDOM
  LEAST_OFTEN_PLAYED
}

enum JingleType {
  STATION_ID
  SWEEPER
  SFX
  PROMO
  ADVERT
  OTHER
}

enum ScheduledItemStatus {
  PENDING
  PLAYED
  SKIPPED
  CANCELLED
}

enum ExternalStreamStatus {
  SCHEDULED
  PLAYING
  STOPPED
  FAILED
  CANCELLED
}

enum SeparationRuleScope {
  GLOBAL
  CLOCK_WHEEL // future: scoped to a specific ClockWheel
}

enum PlaybackSource {
  CLOCK_WHEEL
  SCHEDULED_ITEM
  MANUAL
  EXTERNAL_STREAM
  LIVE_MIC
}

enum PlaybackMediaKind {
  SONG
  JINGLE
  EXTERNAL_STREAM
  LIVE_MIC
}

// ── Users / auth ─────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         Role      @default(MANAGER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdSongs           Song[]                @relation("SongCreatedBy")
  createdJingles         Jingle[]               @relation("JingleCreatedBy")
  createdAds             Ad[]                  @relation("AdCreatedBy")
  createdScheduledItems   ScheduledItem[]
  createdExternalStreams  ExternalStream[]
  updatedSeparationRules  SeparationRule[]
  updatedStationSettings  StationSettings[]
  commandAuditLogs        CommandAuditLog[]
}

// ── Library: songs & jingles ─────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String   @unique // "ALL", "TOP", "HITS", ...
  createdAt DateTime @default(now())

  songs           Song[]
  jingles         Jingle[]
  ads             Ad[]
  clockWheelSteps ClockWheelStep[]
}

model Song {
  id            String    @id @default(cuid())
  title         String
  artist        String
  album         String?
  durationMs    Int
  fileKey       String    @unique // MinIO object key, e.g. songs/{id}/original.mp3
  fileMimeType  String
  fileSizeBytes Int
  coverArtKey   String? // MinIO object key for extracted/uploaded cover art
  categories    Category[] // user-defined; every song is also always attached to "ALL"
  tags          String[]  @default([])
  isActive      Boolean   @default(true) // soft-disable, keeps history FKs intact
  stationId     String? // multi-station scaffold, unused in v1
  createdById   String?
  createdBy     User?     @relation("SongCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  scheduledItems  ScheduledItem[]
  playbackHistory PlaybackHistoryEntry[]

  @@index([artist])
}

model Jingle {
  id            String     @id @default(cuid())
  title         String
  type          JingleType @default(OTHER)
  tags          String[]   @default([])
  durationMs    Int
  fileKey       String     @unique
  fileMimeType  String
  fileSizeBytes Int
  categories    Category[] // user-defined; every jingle is also always attached to "ALL"
  isActive      Boolean    @default(true)
  stationId     String?
  createdById   String?
  createdBy     User?      @relation("JingleCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  scheduledItems  ScheduledItem[]
  playbackHistory PlaybackHistoryEntry[]

  @@index([type])
}

// ── Ads ───────────────────────────────────────────────────────────────────
// A third media kind alongside songs/jingles: no user-facing categories (the
// app layer only ever attaches the single "ALL" category, so ad selection can
// reuse the same category-scoped queries as songs/jingles later without a
// special case) but a mandatory datetime active window -- queue resolution
// (still a TODO stub elsewhere in this codebase) must exclude any Ad outside
// [activeFrom, activeUntil] rather than ever falling back to "always eligible".

model Ad {
  id            String     @id @default(cuid())
  title         String
  durationMs    Int
  fileKey       String     @unique
  fileMimeType  String
  fileSizeBytes Int
  activeFrom    DateTime
  activeUntil   DateTime
  categories    Category[] // app layer restricts this to "ALL" only -- see ads.routes.ts
  isActive      Boolean    @default(true)
  stationId     String?
  createdById   String?
  createdBy     User?      @relation("AdCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  scheduledItems ScheduledItem[]

  @@index([activeFrom, activeUntil])
}

// ── One-off scheduled items ──────────────────────────────────────────────

model ScheduledItem {
  id           String              @id @default(cuid())
  // null = a manually-queued item ("play as soon as due" -- the FIFO manual
  // queue orders these by `position`); non-null = a time-scheduled one-off
  // item (the not-yet-built Schedule feature).
  scheduledFor DateTime?
  position     Int                 @default(0) // ordering when several items share a timestamp (or are all unscheduled)
  mediaKind    MediaKind
  songId       String?
  song         Song?               @relation(fields: [songId], references: [id])
  jingleId     String?
  jingle       Jingle?             @relation(fields: [jingleId], references: [id])
  adId         String?
  ad           Ad?                 @relation(fields: [adId], references: [id])
  status       ScheduledItemStatus @default(PENDING)
  stationId    String?
  createdById  String
  createdBy    User                @relation(fields: [createdById], references: [id])
  createdAt    DateTime            @default(now())
  playedAt     DateTime?

  playbackHistory PlaybackHistoryEntry[]

  @@index([scheduledFor, status])
  // NOTE: Prisma cannot express "exactly one of songId/jingleId/adId set, matching mediaKind"
  // as a schema-level constraint. Enforce in the application layer (zod) and optionally
  // add a hand-written CHECK constraint via a raw-SQL migration.
}

// ── Clock wheels ─────────────────────────────────────────────────────────

model ClockWheel {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  stationId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots           ClockWheelSlot[]
  steps           ClockWheelStep[]
  separationRules SeparationRule[] // future per-wheel scoping
}

model ClockWheelSlot {
  id           String     @id @default(cuid())
  clockWheelId String
  clockWheel   ClockWheel @relation(fields: [clockWheelId], references: [id], onDelete: Cascade)
  weekdays     Int[] // 0=Sun..6=Sat; e.g. Mon-Fri => [1,2,3,4,5]
  startTime    DateTime   @db.Time()
  endTime      DateTime   @db.Time()

  @@index([clockWheelId])
}

model ClockWheelStep {
  id                String            @id @default(cuid())
  clockWheelId      String
  clockWheel        ClockWheel        @relation(fields: [clockWheelId], references: [id], onDelete: Cascade)
  order             Int
  mediaKind         MediaKind
  selectionStrategy SelectionStrategy
  categoryId        String? // required when mediaKind = SONG
  category          Category?         @relation(fields: [categoryId], references: [id])
  tag               String? // optional filter, e.g. jingle tag
  createdAt         DateTime          @default(now())

  playbackHistory PlaybackHistoryEntry[]

  @@unique([clockWheelId, order])
}

// ── Separation rules (global today, scopable later) ──────────────────────

model SeparationRule {
  id                      String              @id @default(cuid())
  scope                   SeparationRuleScope @default(GLOBAL)
  clockWheelId            String? // null while scope = GLOBAL
  clockWheel              ClockWheel?         @relation(fields: [clockWheelId], references: [id])
  artistSeparationMinutes Int                 @default(60)
  songSeparationMinutes   Int                 @default(120)
  updatedAt               DateTime            @updatedAt
  updatedById             String?
  updatedBy               User?               @relation(fields: [updatedById], references: [id])
  // App enforces a single GLOBAL row for v1. Add via raw-SQL migration if DB-level
  // enforcement is wanted:
  //   CREATE UNIQUE INDEX one_global_separation_rule ON "SeparationRule" (scope)
  //   WHERE scope = 'GLOBAL' AND "clockWheelId" IS NULL;
}

// ── Station branding (name/logo/description/links) ───────────────────────
// A single row (app enforces this via findFirst-or-create, same pattern as
// the single GLOBAL SeparationRule above) -- public-readable, manager-editable.

model StationSettings {
  id           String   @id @default(cuid())
  name         String   @default("Spectado Radio")
  description  String?
  logoKey      String? // MinIO object key, square image
  logoMimeType String?
  links        Json     @default("[]") // StationLinkDTO[] -- {platform, url, label?}
  updatedAt    DateTime @updatedAt
  updatedById  String?
  updatedBy    User?    @relation(fields: [updatedById], references: [id])
}

// ── External stream scheduling ────────────────────────────────────────────

model ExternalStream {
  id          String               @id @default(cuid())
  name        String
  url         String
  startAt     DateTime
  endAt       DateTime
  status      ExternalStreamStatus @default(SCHEDULED)
  stationId   String?
  createdById String
  createdBy   User                 @relation(fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  playbackHistory PlaybackHistoryEntry[]

  @@index([startAt, endAt])
}

// ── Now-playing / history ─────────────────────────────────────────────────
// Live "now playing" state is served from Redis; this table is the durable
// append-only log used for separation-rule lookups + reporting, and can
// reconstruct "now playing" (latest row, endedAt IS NULL) if Redis is cold.

model PlaybackHistoryEntry {
  id               String            @id @default(cuid())
  mediaKind        PlaybackMediaKind
  songId           String?
  song             Song?             @relation(fields: [songId], references: [id])
  jingleId         String?
  jingle           Jingle?           @relation(fields: [jingleId], references: [id])
  externalStreamId String?
  externalStream   ExternalStream?   @relation(fields: [externalStreamId], references: [id])
  source           PlaybackSource
  clockWheelStepId String? // traceability: which rule picked this item
  clockWheelStep   ClockWheelStep?   @relation(fields: [clockWheelStepId], references: [id])
  scheduledItemId  String?
  scheduledItem    ScheduledItem?    @relation(fields: [scheduledItemId], references: [id])
  startedAt        DateTime
  endedAt          DateTime?
  durationMs       Int?
  titleSnapshot    String // denormalized: history stays correct if Song/Jingle later edited/deleted
  artistSnapshot   String?
  stationId        String?
  createdAt        DateTime          @default(now())

  @@index([songId, startedAt])
  @@index([startedAt])
}

// ── Command audit log (API -> NATS command publishing) ───────────────────

model CommandAuditLog {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  commandSubject String // e.g. "radio.encoder.cmd.advance"
  payload        Json
  result         String? // "published" | "rejected" | error detail
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}
